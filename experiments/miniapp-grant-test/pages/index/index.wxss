.container {
  padding: 24rpx;
  background: #f5f5f5;
  min-height: 100vh;
  box-sizing: border-box;
}

.header {
  margin: 20rpx 0 30rpx;
  text-align: center;
}
.title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #1a1a1a;
}
.sub {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #888;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}
.tid {
  display: block;
  font-size: 26rpx;
  color: #1a1a1a;
  word-break: break-all;
  font-family: monospace;
}
.code {
  display: block;
  font-size: 26rpx;
  color: #2b6cb0;
  word-break: break-all;
  font-family: monospace;
}
.btn-row {
  margin-top: 16rpx;
  display: flex;
  gap: 16rpx;
}
.btn {
  flex: 1;
}

.main-btn {
  background: #07c160;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 16rpx;
  margin: 10rpx 0 30rpx;
}
.main-btn[disabled] {
  background: #a8d5b8;
  color: #fff;
}

.result {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #07c160;
}

.log-card {
  padding-top: 16rpx;
}
.log-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.clear {
  font-size: 24rpx;
  color: #2b6cb0;
}
.log-item {
  font-size: 24rpx;
  color: #444;
  line-height: 1.8;
  font-family: monospace;
  border-top: 1rpx solid #f0f0f0;
  padding: 8rpx 0;
}
