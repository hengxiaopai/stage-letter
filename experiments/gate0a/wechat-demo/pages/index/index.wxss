page {
  background: #f5f7f6;
  color: #17201c;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.page {
  padding: 40rpx 28rpx 80rpx;
}

.hero {
  margin: 20rpx 4rpx 36rpx;
  display: flex;
  flex-direction: column;
}

.eyebrow {
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: #597166;
  margin-bottom: 14rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.15;
}

.subtitle {
  margin-top: 16rpx;
  color: #6b7771;
  font-size: 26rpx;
  line-height: 1.6;
}

.card {
  background: #ffffff;
  border: 1rpx solid #e1e7e4;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 14rpx 40rpx rgba(25, 48, 37, 0.05);
}

.label,
.key {
  color: #708078;
  font-size: 22rpx;
}

.input {
  margin: 14rpx 0 22rpx;
  padding: 22rpx 20rpx;
  border-radius: 18rpx;
  background: #f3f6f4;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 28rpx;
}

.button {
  background: #173f31;
  color: #fff;
  border-radius: 18rpx;
  font-size: 28rpx;
}

.button::after {
  border: 0;
}

.status-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 26rpx;
}

.status {
  font-size: 34rpx;
  font-weight: 800;
}

.status-LIVE { color: #137d4c; }
.status-OFFLINE { color: #6d7671; }
.status-UNKNOWN { color: #b26c19; }

.provider {
  font-size: 22rpx;
  color: #78837e;
}

.row {
  display: flex;
  justify-content: space-between;
  gap: 28rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid #edf0ee;
}

.value {
  flex: 1;
  text-align: right;
  color: #22312a;
  font-size: 24rpx;
  word-break: break-all;
}

.mono {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
}

.evidence {
  padding-top: 18rpx;
  border-top: 1rpx solid #edf0ee;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.evidence .value {
  text-align: left;
}

.error-card {
  border-color: #efd7cc;
  background: #fffaf7;
}

.error-text {
  display: block;
  margin-top: 10rpx;
  color: #a14e2d;
  font-size: 25rpx;
}

.footnote {
  display: block;
  margin-top: 28rpx;
  color: #8a9690;
  font-size: 21rpx;
}
