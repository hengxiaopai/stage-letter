# StageLetter 环境配置模板
# 复制为 .env 后填入真实值(.env 不入 git)

# 调试
STAGE_LETTER_DEBUG=true

# 数据库(开发容器在 5643,本机 PG 在 5432)
STAGE_LETTER_DATABASE_URL=postgresql+asyncpg://stageletter:stageletter@localhost:5643/stageletter

# Redis
STAGE_LETTER_REDIS_URL=redis://localhost:6379/0

# 微信小程序正式号(⚠️ Secret 敏感,只放 .env)
STAGE_LETTER_WX_APPID=wx370fb6f14d4a4a26
STAGE_LETTER_WX_SECRET=
STAGE_LETTER_WX_TEMPLATE_LIVE_START=VehDuOW2xRXubcWgFvcgnFnp42wdA3uesHpjfmBP-Cs

# 抖音昵称搜索（TikHub，可选；真实 Key 只放本地 .env，绝不提交）
STAGE_LETTER_TIKHUB_API_KEY=

# 轮询
STAGE_LETTER_PROBE_MIN_INTERVAL=3
STAGE_LETTER_PROBE_TIMEOUT=8
