.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
  display: flex;
  min-height: 108rpx;
  box-sizing: border-box;
  padding: 10rpx 0 calc(12rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e7edf8;
  background: #fff;
  box-shadow: 0 -8rpx 24rpx rgba(43, 89, 185, .04);
}

.tab-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.tab-icon {
  width: 66rpx;
  height: 66rpx;
  opacity: .42;
}

.tab-icon-on { opacity: 1; }

.tab-text {
  font-size: 22rpx;
  line-height: 1.2;
  color: #929cb2;
}

.tab-text-on {
  color: #2c6ef2;
  font-weight: 700;
}
