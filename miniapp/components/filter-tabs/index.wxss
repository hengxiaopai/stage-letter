.ft { display: flex; white-space: nowrap; padding: 8rpx 0; }
.ft-item { display: inline-flex; align-items: center; justify-content: center; min-width: 88rpx; box-sizing: border-box; font-size: 26rpx; color: #53617d; background: #fff; border: 1rpx solid #e0e8f7; border-radius: 16rpx; padding: 15rpx 18rpx; margin-right: 14rpx; box-shadow: 0 5rpx 14rpx rgba(50,101,215,.05); }
.ft-on { background: #2c6ef2; color: #fff; border-color: #2c6ef2; font-weight: 700; box-shadow: 0 8rpx 16rpx rgba(44,110,242,.18); }
