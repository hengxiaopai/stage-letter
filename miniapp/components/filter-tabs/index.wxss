.ft { display: flex; white-space: nowrap; padding: 0; }
.ft-item { display: inline-flex; align-items: center; justify-content: center; min-width: 68rpx; box-sizing: border-box; font-size: 22rpx; color: #596883; background: #fff; border: 1rpx solid #e2e8f3; border-radius: 999rpx; padding: 8rpx 16rpx; margin-right: 14rpx; }
.ft-on { background: #2f6bff; color: #fff; border-color: #2f6bff; font-weight: 600; }
