.mask {
  position: fixed;
  inset: 0;
  background: rgba(23, 26, 25, 0.32);
  z-index: 100;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--surface);
  border-radius: var(--r-lg) var(--r-lg) 0 0;
  box-shadow: var(--shadow-sheet);
  z-index: 101;
  padding: 8px 0 calc(8px + env(safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform 0.25s ease;
}

.sheet-in {
  transform: translateY(0);
}

/* §2.4: 顶部主播名,Secondary */
.sheet-title {
  text-align: center;
  padding: 14px 16px 10px;
  font-weight: 600;
  color: var(--text-secondary);
}

/* 普通操作 */
.sheet-row {
  text-align: center;
  padding: 16px;
  font-size: 16px;
  color: var(--text-primary);
  border-top: 1px solid var(--border);
}

/* §2.4: 破坏性操作 Destructive 红 */
.sheet-row-danger {
  color: var(--destructive);
  font-weight: 500;
}

/* §2.4: 取消 Neutral */
.sheet-cancel {
  text-align: center;
  padding: 16px;
  font-size: 16px;
  color: var(--text-secondary);
  border-top: 1px solid var(--border);
}
