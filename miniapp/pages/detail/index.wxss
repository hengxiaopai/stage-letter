/* 主播详情 — 主播消费页 */

.detail-page {
  padding-top: 16px;
}

/* 主播头部 */
.detail-head {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 20px 0 24px;
}

.detail-info {
  flex: 1;
  min-width: 0;
}

.detail-name-row {
  display: flex;
  align-items: center;
  gap: 8px;
}

.detail-name {
  font-size: 20px;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-status {
  margin-top: 8px;
  font-size: 14px;
  font-weight: 500;
}

.st-live {
  color: var(--live);
}

.st-off {
  color: var(--offline);
}

/* 直播信息 */
.detail-session {
  padding: 8px 0 16px;
}

.detail-session-title {
  font-weight: 600;
  font-size: 16px;
  color: var(--text-primary);
}

.detail-session-meta {
  margin-top: 6px;
  color: var(--text-secondary);
}

/* §4.2 未开播态: 两行自然语言,无需 Card */
.detail-session-sub {
  margin-top: 4px;
  color: var(--text-tertiary);
}

/* §4.4 无记录: 轻量 Empty State,紧跟 Section 下方 */
.history-empty {
  padding: 32px 0;
  text-align: center;
}

.history-empty .t-meta {
  color: var(--text-tertiary);
}

/* 骨架屏 */
.sk-row {
  display: flex;
  align-items: center;
}

.sk-lines {
  flex: 1;
  margin-left: 12px;
}

/* P0: 中间态(确认中/无法确认)弱提示色 */
.st-dim {
  color: var(--text-tertiary);
}
