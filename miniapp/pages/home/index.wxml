<view class="page home-page">
  <home-brand-header />
  <home-search-bar />
  <announcement-bar />

  <view wx:if="{{loading}}">
    <view class="skeleton" wx:for="{{[1,2]}}" wx:key="*this">
      <view class="sk-row">
        <view class="skeleton-row skeleton-circle" style="width:56px;height:56px;"></view>
      </view>
    </view>
  </view>

  <view wx:elif="{{error}}" class="empty">
    <view class="empty-icon">!</view>
    <view class="empty-title">加载失败</view>
    <view class="empty-sub">{{error}}</view>
    <primary-button bindtap="retryLoad">重新加载</primary-button>
  </view>

  <empty-subscription-card wx:elif="{{total === 0}}" />

  <block wx:else>
    <block wx:if="{{liveList.length > 0}}">
      <section-header title="正在直播"/>
      <view wx:for="{{liveList}}" wx:key="anchor_id">
        <live-anchor-feature
          avatar="{{item.anchor_avatar}}"
          name="{{item.anchor_name}}"
          platform="{{item.platform}}"
          platformLabel="{{item.platformLabel}}"
          title="{{item.title}}"
          meta="{{item.meta}}"
          data-id="{{item.anchor_id}}"
          bindtap="goDetail"
        />
      </view>
    </block>

    <block wx:if="{{checkingList.length > 0}}">
      <section-header title="状态确认中"/>
      <view wx:for="{{checkingList}}" wx:key="anchor_id" class="wait-row">
        <text class="wait-name">{{item.anchor_name}}</text>
      </view>
    </block>

    <block wx:if="{{liveList.length === 0 && checkingList.length === 0 && unknownList.length === 0 && waitList.length === 0}}">
      <empty-live-card />
    </block>
  </block>
</view>
