<view class="page home-page">
  <home-brand-header />
  <home-search-bar bind:search="goSearch" />

  <view wx:if="{{loading}}" class="home-loading" aria-label="正在读取订阅与主播状态">
    <view class="loading-line loading-brand"></view>
    <view class="loading-card"></view>
    <view class="loading-card"></view>
  </view>

  <view wx:elif="{{error}}" class="home-error">
    <text class="home-error-title">暂时无法读取订阅</text>
    <text class="home-error-copy">请检查网络后重试，已保存的数据不会受影响。</text>
    <view class="retry-button" bindtap="retryLoad">重新加载</view>
  </view>

  <block wx:else>
    <block wx:if="{{total === 0}}">
      <empty-live-card />
      <empty-subscription-card />
    </block>

    <block wx:else>
      <view wx:if="{{featuredLive}}" class="live-section">
        <view class="section-heading live-heading">
          <view class="section-title">正在直播<view class="live-count">{{liveCount}}</view></view>
          <text class="section-more" bindtap="showLiveSubscriptions">查看全部</text>
        </view>
        <view class="featured-live-card" data-id="{{featuredLive.anchor_id}}" bindtap="goDetail">
          <anchor-avatar src="{{featuredLive.anchor_avatar}}" name="{{featuredLive.anchor_name}}" size="lg" />
          <view class="featured-live-copy">
            <view class="featured-live-title"><text class="featured-live-name">{{featuredLive.anchor_name}}</text><text class="status-pill status-live">直播中</text></view>
            <text class="featured-live-subtitle">{{featuredLive.title || '正在直播中'}}</text>
            <text class="featured-live-meta">{{featuredLive.platformLabel}} · {{featuredLive.liveMeta}}</text>
          </view>
          <view class="live-entry">进入直播间</view>
        </view>
      </view>

      <view wx:else class="quiet-section">
        <view class="quiet-status-card" bindtap="goAdd">
          <view class="quiet-icon">☾</view>
          <view class="quiet-copy">
            <text class="quiet-title">当前没有已确认开播</text>
            <text class="quiet-meta">{{quietSummary}}</text>
          </view>
          <text class="quiet-discover">发现 ›</text>
        </view>
      </view>

      <view class="subscription-section">
        <view class="section-heading subscription-heading">
          <view class="section-title">我的订阅 · {{total}}</view>
          <text class="section-more" bindtap="goSubscriptions">管理</text>
        </view>
        <view class="subscription-filters" aria-label="订阅状态筛选">
          <view wx:for="{{subscriptionFilters}}" wx:key="value" class="subscription-filter {{subscriptionFilter === item.value ? 'subscription-filter-on' : ''}}" data-value="{{item.value}}" bindtap="selectSubscriptionFilter">{{item.label}}</view>
        </view>
        <view class="subscription-list">
          <view class="subscription-row" wx:for="{{visibleSubscriptionRows}}" wx:key="anchor_id" data-id="{{item.anchor_id}}" bindtap="goDetail">
            <anchor-avatar src="{{item.anchor_avatar}}" name="{{item.anchor_name}}" size="md" />
            <view class="subscription-body">
              <view class="subscription-topline"><text class="subscription-name">{{item.anchor_name}}</text><text class="status-pill {{item.stateClass}}">{{item.stateLabel}}</text></view>
              <text class="subscription-summary">{{item.platformLabel}} · {{item.rowMeta}}</text>
            </view>
            <text class="row-chevron">›</text>
          </view>
          <view wx:if="{{visibleSubscriptionRows.length === 0}}" class="filtered-empty">该状态下暂无订阅主播</view>
        </view>
      </view>
    </block>
  </block>
</view>
