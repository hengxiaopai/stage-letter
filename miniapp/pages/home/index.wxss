/* UI V2.3 Home: Figma 3:2 Home / Live and 5:2 Home / Quiet. */
.home-page { min-height: 100vh; padding: 48rpx 36rpx calc(168rpx + env(safe-area-inset-bottom)); background: #f6f8fc; }

.home-page home-brand-header { display: block; }
.home-page home-search-bar { display: block; margin-top: 28rpx; }

.home-loading { padding-top: 28rpx; }
.loading-line, .loading-card { border-radius: 36rpx; background: linear-gradient(90deg, #edf1f7 25%, #f7f9fd 37%, #edf1f7 63%); background-size: 400% 100%; animation: home-shimmer 1.4s ease infinite; }
.loading-brand { width: 220rpx; height: 36rpx; margin-bottom: 28rpx; }
.loading-card { height: 208rpx; margin-bottom: 24rpx; }
@keyframes home-shimmer { 0% { background-position: 100% 50%; } 100% { background-position: 0 50%; } }

.home-error { display: flex; flex-direction: column; align-items: center; padding: 144rpx 40rpx; text-align: center; }
.home-error-title { color: #15213a; font-size: 36rpx; font-weight: 700; }
.home-error-copy { margin-top: 14rpx; color: #7c8aa5; font-size: 26rpx; line-height: 1.6; }
.retry-button { margin-top: 32rpx; padding: 18rpx 38rpx; border-radius: 999rpx; background: #2f6bff; color: #fff; font-size: 26rpx; font-weight: 600; }

.live-section { padding-top: 24rpx; }
.quiet-section { padding-top: 8rpx; }
.subscription-section { padding-top: 20rpx; }
.section-heading { display: flex; align-items: center; justify-content: space-between; }
.live-heading { margin-bottom: 20rpx; }
.subscription-heading { margin-bottom: 16rpx; }
.section-title { display: flex; align-items: center; color: #15213a; font-size: 36rpx; font-weight: 700; line-height: 50rpx; }
.live-count { min-width: 30rpx; margin-left: 12rpx; padding: 4rpx 12rpx; border-radius: 999rpx; background: #ffe9ec; color: #f04452; font-size: 22rpx; font-weight: 600; line-height: 30rpx; text-align: center; }
.section-more { color: #7c8aa5; font-size: 24rpx; line-height: 34rpx; }

.featured-live-card { display: flex; align-items: center; min-height: 156rpx; box-sizing: border-box; padding: 26rpx 28rpx; border: 1rpx solid #e2e8f3; border-radius: 36rpx; background: #fff; }
.featured-live-copy { flex: 1; min-width: 0; margin-left: 24rpx; }
.featured-live-title, .subscription-topline { display: flex; align-items: center; min-width: 0; gap: 12rpx; }
.featured-live-name { max-width: 178rpx; overflow: hidden; color: #15213a; font-size: 28rpx; font-weight: 700; line-height: 40rpx; text-overflow: ellipsis; white-space: nowrap; }
.featured-live-subtitle { display: block; margin-top: 4rpx; overflow: hidden; color: #34425d; font-size: 24rpx; line-height: 34rpx; text-overflow: ellipsis; white-space: nowrap; }
.featured-live-meta { display: block; margin-top: 2rpx; overflow: hidden; color: #7c8aa5; font-size: 22rpx; line-height: 30rpx; text-overflow: ellipsis; white-space: nowrap; }
.live-entry { flex: 0 0 auto; margin-left: 12rpx; padding: 16rpx 22rpx; border-radius: 999rpx; background: #2f6bff; color: #fff; font-size: 22rpx; font-weight: 600; line-height: 30rpx; }

.quiet-status-card { display: flex; align-items: center; padding: 26rpx 28rpx; border: 1rpx solid #dce8ff; border-radius: 36rpx; background: #eef4ff; }
.quiet-icon { width: 84rpx; height: 84rpx; display: flex; align-items: center; justify-content: center; border-radius: 28rpx; background: #fff; color: #5c7fef; font-size: 38rpx; line-height: 1; }
.quiet-copy { flex: 1; min-width: 0; margin-left: 24rpx; }
.quiet-title, .quiet-meta { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.quiet-title { color: #20345d; font-size: 28rpx; font-weight: 700; line-height: 40rpx; }
.quiet-meta { margin-top: 2rpx; color: #7281a0; font-size: 24rpx; line-height: 34rpx; }
.quiet-discover { flex: 0 0 auto; margin-left: 12rpx; color: #2f6bff; font-size: 24rpx; font-weight: 600; }

.subscription-filters { display: flex; gap: 36rpx; height: 38rpx; margin-bottom: 20rpx; }
.subscription-filter { color: #7c8aa5; font-size: 26rpx; line-height: 36rpx; }
.subscription-filter-on { color: #2f6bff; font-weight: 700; }
.subscription-list { overflow: hidden; border: 1rpx solid #e2e8f3; border-radius: 36rpx; background: #fff; }
.subscription-row { display: flex; align-items: center; min-height: 122rpx; padding: 20rpx 24rpx; box-sizing: border-box; border-bottom: 1rpx solid #eef2f7; }
.subscription-row:last-child { border-bottom: 0; }
.subscription-body { flex: 1; min-width: 0; margin-left: 20rpx; }
.subscription-name { max-width: 210rpx; overflow: hidden; color: #15213a; font-size: 28rpx; font-weight: 700; line-height: 40rpx; text-overflow: ellipsis; white-space: nowrap; }
.status-pill { flex: 0 0 auto; padding: 7rpx 16rpx; border-radius: 999rpx; font-size: 22rpx; font-weight: 500; line-height: 30rpx; }
.status-live { background: #ffe9ec; color: #f04452; }
.status-offline { background: #f1f4f8; color: #7c8aa5; }
.status-checking { background: #fff2d8; color: #a96500; }
.status-unknown { background: #fff2d8; color: #a96500; }
.status-error { background: #fff0f0; color: #d94754; }
.subscription-summary { display: block; margin-top: 2rpx; overflow: hidden; color: #7c8aa5; font-size: 22rpx; line-height: 30rpx; text-overflow: ellipsis; white-space: nowrap; }
.row-chevron { flex: 0 0 auto; margin-left: 14rpx; color: #a3aec2; font-size: 44rpx; font-weight: 300; line-height: 1; }
.filtered-empty { padding: 60rpx 20rpx; color: #7c8aa5; font-size: 26rpx; text-align: center; }
