/* 首页 Empty State UI */
.home-page {
  padding-top: 20px;
}

.wait-row {
  display:flex;
  align-items:center;
  min-height:64px;
  padding:0 32rpx;
}

.wait-name {
  font-size:28rpx;
  color:var(--text-primary);
}

.sk-row {
  display:flex;
  align-items:center;
}

.home-page announcement-bar,
.home-page empty-live-card,
.home-page empty-subscription-card {
  display:block;
}
