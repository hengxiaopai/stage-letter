<view class="page messages-page">
  <home-brand-header />
  <view class="messages-heading"><text>消息</text><text>开播提醒与站内通知</text></view>
  <view class="message-tabs"><view class="message-tab message-tab-on">开播通知<text class="unread-badge">{{items.length}}</text></view><view class="message-tab">互动消息</view><view class="message-tab">系统消息</view></view>
  <view wx:if="{{loading}}" class="messages-loading">正在加载消息…</view>
  <view wx:elif="{{error}}" class="empty"><view class="empty-title">消息加载失败</view><view class="empty-sub">{{error}}</view><primary-button bindtap="retryLoad">重新加载</primary-button></view>
  <view wx:elif="{{items.length === 0}}" class="messages-empty"><image src="/assets/empty/no-live-letter.png" mode="aspectFit"/><text>暂无开播通知</text><text>订阅的主播开播后，会在这里留下提醒记录</text></view>
  <view wx:else class="message-list"><view class="message-row" wx:for="{{items}}" wx:key="id" data-id="{{item.anchor_id}}" bindtap="goDetail"><anchor-avatar src="{{item.avatar}}" name="{{item.display_name}}" size="lg"/><view class="message-body"><view class="message-top"><text class="message-name">{{item.display_name || '主播'}}</text><text class="message-time">{{item.meta}}</text></view><text class="message-title">{{item.title}}</text><text class="message-copy">点击查看主播详情与本场直播信息</text><text class="message-tag">开播通知</text></view><view class="message-cta">去观看</view></view></view>
</view>
