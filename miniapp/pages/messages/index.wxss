.messages-page { min-height: 100vh; padding: 0 36rpx calc(170rpx + env(safe-area-inset-bottom)); background: #f6f8fc; }
.messages-appbar { display: flex; align-items: center; justify-content: space-between; height: 144rpx; }
.messages-appbar text:first-child { color: #15213a; font-size: 50rpx; font-weight: 400; }
.messages-appbar text:nth-child(2) { color: #15213a; font-size: 30rpx; font-weight: 800; }
.messages-appbar text:last-child { color: #2f6bff; font-size: 23rpx; font-weight: 600; }
.messages-header { display: flex; align-items: center; justify-content: space-between; margin: 4rpx 0 16rpx; }
.messages-header text:first-child { color: #15213a; font-size: 36rpx; font-weight: 800; }
.messages-header text:last-child { color: #7c8aa5; font-size: 21rpx; }
.messages-loading { padding: 150rpx 0; text-align: center; color: #7c8aa5; font-size: 26rpx; }
.message-list { overflow: hidden; margin-top: 20rpx; border: 1rpx solid #e2e8f3; border-radius: 36rpx; background: #fff; }
.message-row { display: flex; align-items: center; gap: 18rpx; min-height: 104rpx; padding: 22rpx; border-bottom: 1rpx solid #eef2f7; }
.message-row:last-child { border: 0; }
.message-body { flex: 1; min-width: 0; }
.message-top { display: flex; align-items: center; gap: 12rpx; }
.message-name { overflow: hidden; color: #34425d; font-size: 26rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
.delivery-pill { flex: 0 0 auto; padding: 4rpx 12rpx; border-radius: 999rpx; font-size: 20rpx; font-weight: 600; }
.delivery-sent { background: #eaf7f1; color: #2b8a66; }
.delivery-failed { background: #fcebec; color: #b44955; }
.delivery-retry { background: #fff2d8; color: #a96500; }
.delivery-ambiguous { background: #eef2f7; color: #596985; }
.message-title { display: block; margin-top: 4rpx; color: #7c8aa5; font-size: 20rpx; }
.message-copy { display: block; margin-top: 2rpx; overflow: hidden; color: #596985; font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }
.messages-empty { display: flex; flex-direction: column; align-items: center; padding: 130rpx 0; color: #15213a; font-size: 32rpx; font-weight: 800; }
.messages-empty image { width: 240rpx; height: 170rpx; margin-bottom: 20rpx; }
.messages-empty text:last-child { margin-top: 12rpx; color: #7c8aa5; font-size: 23rpx; font-weight: 400; }
.delivery-note { display: flex; flex-direction: column; gap: 6rpx; margin-top: 20rpx; padding: 20rpx 24rpx; border-radius: 28rpx; background: #f1f4f8; }
.delivery-note text:first-child { color: #34425d; font-size: 22rpx; font-weight: 700; }
.delivery-note text:last-child { color: #7c8aa5; font-size: 20rpx; }
