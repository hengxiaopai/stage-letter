.messages-page { min-height: 100vh; padding-top: 14rpx; padding-bottom: calc(188rpx + env(safe-area-inset-bottom)); background: #f5f8ff; }.messages-heading { margin: 20rpx 0 28rpx; text-align: center; }.messages-heading text:first-child { display: block; color: #142353; font-size: 46rpx; font-weight: 800; }.messages-heading text:last-child { display: block; margin-top: 7rpx; font-size: 24rpx; color: #8995ad; }.message-tabs { display: flex; overflow: hidden; height: 78rpx; margin-bottom: 26rpx; border-radius: 40rpx; background: #eaf1fc; }.message-tab { flex: 1; display: flex; justify-content: center; align-items: center; color: #75829e; font-size: 26rpx; }.message-tab-on { margin: 6rpx; border-radius: 34rpx; background: #fff; color: #2c6ef2; font-weight: 800; box-shadow: 0 6rpx 18rpx rgba(50,101,215,.08); }.unread-badge { margin-left: 10rpx; padding: 0 12rpx; border-radius: 18rpx; background: #2c6ef2; color: #fff; font-size: 20rpx; line-height: 32rpx; }.messages-loading { padding: 100rpx 0; text-align: center; color: #8290ae; font-size: 27rpx; }.message-list { display: flex; flex-direction: column; gap: 18rpx; }.message-row { display: flex; align-items: center; gap: 18rpx; min-height: 142rpx; box-sizing: border-box; padding: 22rpx; border: 1rpx solid #e6ecfa; border-radius: 26rpx; background: #fff; box-shadow: 0 12rpx 28rpx rgba(50,101,215,.055); }.message-body { flex: 1; min-width: 0; }.message-top { display: flex; justify-content: space-between; align-items: center; gap: 10rpx; }.message-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #1b2546; font-size: 29rpx; font-weight: 800; }.message-time { flex: 0 0 auto; color: #8995ad; font-size: 22rpx; }.message-title { display: block; margin-top: 6rpx; color: #1b2546; font-size: 27rpx; font-weight: 700; }.message-copy { display: block; margin-top: 4rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #8490a9; font-size: 22rpx; }.message-tag { display: inline-block; margin-top: 8rpx; padding: 3rpx 10rpx; border-radius: 10rpx; background: #edf4ff; color: #2c6ef2; font-size: 20rpx; }.message-cta { flex: 0 0 auto; padding: 12rpx 15rpx; border-radius: 15rpx; background: #2c6ef2; color: #fff; font-size: 23rpx; font-weight: 700; }.messages-empty { display: flex; flex-direction: column; align-items: center; padding: 90rpx 0; color: #142353; font-size: 34rpx; font-weight: 800; }.messages-empty image { width: 260rpx; height: 190rpx; margin-bottom: 20rpx; }.messages-empty text:last-child { margin-top: 12rpx; color: #8793ad; font-size: 24rpx; font-weight: 400; }
