.profile-page { min-height: 100vh; padding: 42rpx 36rpx calc(170rpx + env(safe-area-inset-bottom)); background: #f6f8fc; }.profile-loading { padding: 160rpx 0; text-align: center; color: #7c8aa5; font-size: 26rpx; }.profile-appbar { margin-bottom: 28rpx; }.profile-appbar text:first-child { display: block; color: #15213a; font-size: 48rpx; line-height: 1.2; font-weight: 800; }.profile-appbar text:last-child { display: block; margin-top: 8rpx; color: #7c8aa5; font-size: 24rpx; }.identity-card { display: flex; align-items: center; gap: 18rpx; padding: 24rpx; border: 1rpx solid #e2e8f3; border-radius: 36rpx; background: #fff; }.identity-card image { width: 76rpx; height: 76rpx; flex: 0 0 auto; }.identity-card view { display: flex; min-width: 0; flex-direction: column; }.identity-title { color: #15213a; font-size: 30rpx; font-weight: 800; }.identity-copy { margin-top: 6rpx; color: #7c8aa5; font-size: 22rpx; }.fact-grid { display: flex; margin: 20rpx 0; padding: 18rpx 0; border: 1rpx solid #e2e8f3; border-radius: 36rpx; background: #fff; }.fact-grid view { display: flex; flex: 1; min-width: 0; flex-direction: column; align-items: center; border-right: 1rpx solid #eaf0f8; }.fact-grid view:last-child { border: 0; }.fact-grid text:first-child { color: #15213a; font-size: 34rpx; font-weight: 800; }.fact-grid text:last-child { margin-top: 4rpx; color: #7c8aa5; font-size: 20rpx; white-space: nowrap; }.quota-card { display: flex; align-items: center; justify-content: space-between; min-height: 184rpx; box-sizing: border-box; padding: 24rpx 28rpx; border-radius: 36rpx; background: #2f6bff; color: #fff; }.quota-copy { display: flex; min-width: 0; flex-direction: column; }.quota-label { font-size: 25rpx; font-weight: 700; }.quota-number { margin-top: 5rpx; font-size: 64rpx; line-height: 1; font-weight: 800; }.quota-unit { margin-left: 6rpx; font-size: 24rpx; }.quota-detail { margin-top: 8rpx; color: rgba(255,255,255,.78); font-size: 20rpx; }.quota-button { flex: 0 0 auto; margin: 0; padding: 0 20rpx; height: 64rpx; line-height: 64rpx; border: 0; border-radius: 28rpx; background: #fff; color: #2f6bff; font-size: 24rpx; font-weight: 700; }.quota-button::after { border: 0; }.profile-menu { overflow: hidden; margin-top: 20rpx; border: 1rpx solid #e2e8f3; border-radius: 36rpx; background: #fff; }.menu-secondary { margin-top: 16rpx; }.menu-row { display: flex; align-items: center; min-height: 112rpx; padding: 0 22rpx; border-bottom: 1rpx solid #eef2f7; }.menu-row:last-child { border-bottom: 0; }.menu-row image { width: 42rpx; height: 42rpx; flex: 0 0 auto; margin-right: 18rpx; }.menu-row view { display: flex; flex: 1; min-width: 0; flex-direction: column; }.menu-row view text:first-child { color: #34425d; font-size: 28rpx; font-weight: 700; }.menu-row view text:last-child { margin-top: 3rpx; overflow: hidden; color: #7c8aa5; font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }.menu-row > text:last-child { color: #a3aec2; font-size: 38rpx; font-weight: 300; }.profile-note { display: flex; flex-direction: column; gap: 6rpx; margin: 20rpx 0; padding: 20rpx 24rpx; border-radius: 28rpx; background: #f1f4f8; }.profile-note text:first-child { color: #34425d; font-size: 24rpx; font-weight: 700; }.profile-note text:last-child { color: #7c8aa5; font-size: 20rpx; line-height: 1.6; }
