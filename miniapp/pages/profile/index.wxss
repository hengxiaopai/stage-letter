.profile-page { min-height: 100vh; padding-top: 14rpx; padding-bottom: calc(188rpx + env(safe-area-inset-bottom)); background: #f5f8ff; }.profile-loading { padding: 120rpx 0; text-align: center; color: #8290ae; font-size: 27rpx; }.profile-hero { height: 214rpx; margin: 8rpx -32rpx 0; overflow: hidden; background: #eaf2ff; }.profile-hero image { width: 100%; height: 100%; }.profile-card { position: relative; z-index: 1; display: flex; align-items: center; margin: -48rpx 0 0; padding: 24rpx; border-radius: 28rpx; background: rgba(255,255,255,.96); box-shadow: 0 16rpx 40rpx rgba(50,101,215,.09); }.profile-avatar { width: 126rpx; height: 126rpx; flex: 0 0 auto; border: 7rpx solid #fff; border-radius: 50%; background: #dbe9ff; }.profile-copy { display: flex; flex-direction: column; min-width: 0; margin-left: 18rpx; }.profile-name { font-size: 39rpx; font-weight: 800; color: #142353; }.profile-level { display: inline-block; margin-left: 12rpx; padding: 5rpx 13rpx; border-radius: 16rpx; background: #2c6ef2; color: #fff; font-size: 21rpx; }.profile-id { margin-top: 8rpx; font-size: 24rpx; color: #7785a5; }.profile-motto { margin-top: 4rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #8793ad; font-size: 23rpx; }.quota-card { display: flex; align-items: center; justify-content: space-between; min-height: 194rpx; box-sizing: border-box; margin-top: 24rpx; padding: 26rpx 28rpx; border-radius: 28rpx; background: #2c6ef2; box-shadow: 0 16rpx 34rpx rgba(44,110,242,.25); color: #fff; }.quota-copy { display: flex; flex-direction: column; }.quota-label { font-size: 26rpx; font-weight: 700; }.quota-number { margin-top: 8rpx; font-size: 72rpx; line-height: 1; font-weight: 800; }.quota-unit { font-size: 26rpx; }.quota-detail { margin-top: 10rpx; color: rgba(255,255,255,.75); font-size: 22rpx; }.quota-button { flex: 0 0 auto; margin: 0; padding: 0 24rpx; height: 72rpx; line-height: 72rpx; border: none; border-radius: 16rpx; background: #fff; color: #2c6ef2; font-size: 27rpx; font-weight: 800; }.quota-button::after { border: 0; }.profile-menu { overflow: hidden; margin-top: 24rpx; padding: 0 22rpx; border-radius: 28rpx; background: #fff; box-shadow: 0 12rpx 30rpx rgba(50,101,215,.05); }.menu-secondary { margin-top: 18rpx; }.menu-row { display: flex; align-items: center; height: 108rpx; border-bottom: 1rpx solid #edf1f8; }.menu-row:last-child { border-bottom: 0; }.menu-row image { width: 50rpx; height: 50rpx; margin-right: 18rpx; }.menu-row text:nth-child(2) { flex: 1; color: #1b2546; font-size: 31rpx; font-weight: 700; }.menu-row text:last-child { color: #8895af; font-size: 44rpx; font-weight: 300; }.history-preview { margin-top: 26rpx; }.history-head { display: flex; justify-content: space-between; align-items: center; margin: 0 4rpx 12rpx; }.history-head text:first-child { color: #142353; font-size: 34rpx; font-weight: 800; }.history-head text:last-child { color: #2c6ef2; font-size: 24rpx; }.history-preview .nr { padding: 22rpx; border: 0; border-bottom: 1rpx solid #edf1f8; background: #fff; }.history-preview > view:not(.history-head):first-of-type .nr { border-radius: 24rpx 24rpx 0 0; }.history-preview > view:last-child .nr { border-bottom: 0; border-radius: 0 0 24rpx 24rpx; }
