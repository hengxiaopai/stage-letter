.discover-page { min-height: 100vh; padding-top: 14rpx; padding-bottom: calc(188rpx + env(safe-area-inset-bottom)); background: #f5f8ff; }
.discover-search { margin-top: 22rpx; }.discover-tabs { display: flex; gap: 52rpx; margin-top: 25rpx; border-bottom: 1rpx solid #dfe7f7; }.discover-tab { position: relative; padding: 0 2rpx 19rpx; font-size: 29rpx; color: #8490a9; }.discover-tab-on { color: #2468e9; font-weight: 800; }.discover-tab-on::after { content: ''; position: absolute; left: 18%; right: 18%; bottom: -1rpx; height: 5rpx; border-radius: 5rpx; background: #2c6ef2; }
.discover-page filter-tabs { display: block; margin-top: 18rpx; }.topic-tabs { display: flex; justify-content: space-between; margin-top: 28rpx; }.topic-tab { position: relative; padding-bottom: 14rpx; color: #7b87a1; font-size: 26rpx; }.topic-tab-on { color: #2468e9; font-weight: 800; }.topic-tab-on::after { content: ''; position: absolute; left: 30%; right: 30%; bottom: 0; height: 4rpx; border-radius: 4rpx; background: #2c6ef2; }.searching-hint { margin-top: 14rpx; color: #2c6ef2; text-align: right; font-size: 24rpx; }
.discover-notice { margin-top: 20rpx; padding: 18rpx 22rpx; border-radius: 16rpx; background: #fff0f0; color: #dc5556; font-size: 25rpx; line-height: 1.55; }.discover-notice-info { background: #edf4ff; color: #4376d7; }.notice-link { display: block; margin-top: 8rpx; color: #2c6ef2; font-weight: 700; }
.discover-results { margin-top: 30rpx; }.result-heading { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; font-size: 34rpx; font-weight: 800; color: #142353; }.result-heading text:last-child { font-size: 23rpx; color: #8793ad; font-weight: 400; }.result-list { overflow: hidden; padding: 0 22rpx; border: 1rpx solid #e5ebfa; border-radius: 26rpx; background: #fff; box-shadow: 0 12rpx 32rpx rgba(50,101,215,.06); }.result-row { border-bottom: 1rpx solid #edf1f8; }.result-row:last-child { border-bottom: 0; }.result-row .ar { min-height: 118rpx; padding: 18rpx 0; }
.sub-action { flex: 0 0 auto; padding: 12rpx 22rpx; border-radius: 16rpx; background: #2c6ef2; color: #fff; font-size: 24rpx; font-weight: 700; }.action-done { background: #eaf2ff; color: #2c6ef2; }.action-loading { opacity: .6; }
.discover-empty { display: flex; flex-direction: column; align-items: center; padding: 72rpx 0 32rpx; color: #7e8ba7; font-size: 27rpx; }.discover-empty image { width: 230rpx; height: 170rpx; margin-bottom: 16rpx; }.discover-empty text:last-child { margin-top: 8rpx; font-size: 23rpx; color: #9aa5bb; }.link-card { margin-top: 28rpx; padding: 30rpx; border-radius: 26rpx; background: #fff; box-shadow: 0 12rpx 32rpx rgba(50,101,215,.06); }.link-title { display: block; font-size: 34rpx; font-weight: 800; color: #142353; }.link-copy { display: block; margin-top: 10rpx; font-size: 24rpx; color: #8490a9; }.parsed-result { margin-top: 22rpx; }
