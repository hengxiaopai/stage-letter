/**
 * app.wxss — StageLetter 全局设计系统
 * UI-V2.3 · Figma Master restoration
 *
 * 原则:
 * - 390×844 基准: 18px 页面边距、18px 卡片、14px CTA
 * - 品牌蓝仅用于主 CTA、选中态和低频强调;LIVE 独占红色
 * - 以白色 Surface、细边框与留白建立层次，不使用装饰性发光
 */

page {
  /* ─── Neutral 中性色 ─── */
  --bg: #F6F8FC;
  --surface: #FFFFFF;
  --surface-2: #F1F4F8;
  --text-primary: #15213A;
  --text-secondary: #7C8AA5;
  --text-tertiary: #A3AEC2;
  --border: #E2E8F3;

  /* ─── Brand 品牌(克制) ─── */
  --brand: #2F6BFF;
  --brand-soft: #EAF1FF;

  /* ─── Semantic 语义色 ─── */
  --live: #F04452;
  --live-soft: #FFE9EC;
  --online: #2B8A66;
  --online-soft: #EAF7F1;
  --warning: #A96500;
  --warning-soft: #FFF6E3;
  --offline: #7C8AA5;
  --destructive: #D94754;
  --destructive-soft: #FFF0F0;

  /* ─── 平台色(仅小面积 Badge/标识) ─── */
  --c-bilibili: #00AEEC;
  --c-douyin: #3A3A3A;
  --c-huya: #E07A1F;
  --c-douyu: #5E9E2F;

  /* ─── Typography 六档 ─── */
  --t-display: 30px;       /* 28-32 / 700-800 */
  --t-title: 26px;         /* 24-28 / 700 */
  --t-section: 19px;       /* 18-20 / 650-700 */
  --t-anchor: 17px;        /* 16-18 / 600-700 */
  --t-body: 15px;          /* 15-16 / 400 */
  --t-meta: 13px;          /* 12-14 / 400-500 */

  /* ─── Spacing 8 档 ─── */
  --sp-1: 4px;
  --sp-2: 8px;
  --sp-3: 12px;
  --sp-4: 16px;            /* 页面主 gutter */
  --sp-5: 20px;
  --sp-6: 24px;
  --sp-7: 32px;
  --sp-8: 40px;

  /* ─── Radius 三档 ─── */
  --r-sm: 10px;            /* 小控件 */
  --r-md: 14px;            /* CTA / 普通 Surface */
  --r-lg: 18px;            /* 强调 Card / Bottom Sheet */

  /* ─── Shadow(默认无,仅 3 场景) ─── */
  --shadow-none: none;
  --shadow-elev: 0 2px 8px rgba(23, 26, 25, 0.08);   /* Floating CTA */
  --shadow-sheet: 0 -4px 24px rgba(23, 26, 25, 0.10); /* Bottom Sheet */

  background: var(--bg);
  color: var(--text-primary);
  font-size: var(--t-body);
  font-family: "Noto Sans SC", -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
  line-height: 1.5;
}

/* ═══════════════════════════════════════════════════════════
   基础工具
   ═══════════════════════════════════════════════════════════ */

/* 页面容器: 主 gutter 16px, 最大宽度居中 */
.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: var(--sp-4) var(--sp-4) calc(88px + env(safe-area-inset-bottom));
  max-width: 1000rpx;
  margin: 0 auto;
}

/* 隐藏原生滚动条 */
::-webkit-scrollbar {
  width: 0;
  height: 0;
}

/* 安全区底部 */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

/* ─── Typography 实用类 ─── */
.t-display {
  font-size: var(--t-display);
  font-weight: 800;
  letter-spacing: -0.5px;
  line-height: 1.15;
  color: var(--text-primary);
}

.t-title {
  font-size: var(--t-title);
  font-weight: 700;
  letter-spacing: -0.3px;
  color: var(--text-primary);
}

.t-section {
  font-size: var(--t-section);
  font-weight: 650;
  color: var(--text-primary);
}

.t-anchor {
  font-size: var(--t-anchor);
  font-weight: 600;
  color: var(--text-primary);
}

.t-body {
  font-size: var(--t-body);
  font-weight: 400;
  color: var(--text-primary);
}

.t-meta {
  font-size: var(--t-meta);
  font-weight: 400;
  color: var(--text-secondary);
}

.t-meta-strong {
  font-size: var(--t-meta);
  font-weight: 500;
  color: var(--text-primary);
}

/* ─── 分割线(开放式布局核心) ─── */
.divider {
  height: 1px;
  background: var(--border);
}

.divider-inset {
  height: 1px;
  background: var(--border);
  margin-left: 56px; /* 对齐 AnchorRow 文字起点 */
}

/* ─── 按压反馈(基础,组件内可覆盖) ─── */
.press {
  transition: opacity 0.15s ease;
}

.press-hover {
  opacity: 0.6;
}

/* ─── 隐藏 hover 系统高亮 ─── */
button::after,
view {
  -webkit-tap-highlight-color: transparent;
}

/* ─── GPU 合成提示 ─── */
.gpu {
  transform: translateZ(0);
  backface-visibility: hidden;
}

/* ─── 空状态(EmptyState 组件的基础) ─── */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80px 24px;
  text-align: center;
}

.empty-icon {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  background: var(--surface-2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28px;
  margin-bottom: var(--sp-4);
}

.empty-title {
  font-size: var(--t-section);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: var(--sp-2);
}

.empty-sub {
  font-size: var(--t-meta);
  color: var(--text-secondary);
  margin-bottom: var(--sp-6);
  max-width: 280px;
}

/* ─── 骨架屏(加载态) ─── */
.skeleton {
  background: var(--surface);
  border-radius: var(--r-md);
  padding: var(--sp-4);
  margin-bottom: var(--sp-3);
}

.skeleton-row {
  background: linear-gradient(90deg, #F0F2F1 25%, #E4E8E6 37%, #F0F2F1 63%);
  background-size: 400% 100%;
  animation: shimmer 1.4s ease infinite;
  border-radius: 6px;
}

.skeleton-circle {
  border-radius: 50%;
}

@keyframes shimmer {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}
